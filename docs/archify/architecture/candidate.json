  "cards": [
    {
      "dot": "cyan",
      "title": "Análise de Impacto (Runtime)",
      "items": [
        "deck-studio.exe encerra 100% do WebView2 ao fechar; alterações na UI não aumentam RAM em idle",
        "device_mgr + akp-reader usam EngineShared.rt_handle com catch_unwind"
      ]
    },
    {
      "dot": "emerald",
      "title": "Isolamento de Rede & DPC",
      "items": [
        "LibreHWM offline entra em backoff de 30s; NVML fica em standby com AIDA64 ativo",
        "Cache de assinatura em render_all_tiles evita Lanczos3 e HID desnecessários (0% perda UDP)"
      ]
    }
