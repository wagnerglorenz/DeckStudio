  "cards": [
    {
      "dot": "emerald",
      "title": "Economia de CPU & USB",
      "items": [
        "Cache de assinatura em render_all_tiles evita gerar Lanczos3 de teclas paradas",
        "blake3 em DeviceManager evita reescrever pacotes HID idênticos"
      ]
    },
    {
      "dot": "cyan",
      "title": "Isolamento de Telemetria",
      "items": [
        "LibreHWM offline entra em backoff de 30s com timeout curto de 300ms",
        "NVML não é carregado nem consultado enquanto AIDA64 entrega GPU"
      ]
    }
  ]
