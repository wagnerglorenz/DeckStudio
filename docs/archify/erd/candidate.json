  "cards": [
    {
      "dot": "cyan",
      "title": "Persistência Única",
      "items": [
        "Serializado em %APPDATA%\\DeckStudio\\config.json via serde_json",
        "PUT /api/config reinicia backoff de sensores e invalida cache de renderização"
      ]
    },
    {
      "dot": "emerald",
      "title": "Impacto de Schema",
      "items": [
        "Alterações em deck-core/src/config.rs impactam deck-engine e types.ts do editor",
        "Campos novos usam #[serde(default)] para retrocompatibilidade com JSON existente"
      ]
    }
