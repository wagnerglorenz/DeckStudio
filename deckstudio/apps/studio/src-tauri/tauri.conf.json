{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeckStudio",
  "version": "0.1.0",
  "identifier": "com.wagner.deckstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeckStudio — AJAZZ AKP153E",
        "width": 1440,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 740,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
