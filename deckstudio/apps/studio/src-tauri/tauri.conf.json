{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeckStudio",
  "version": "0.4.9",
  "identifier": "com.wagner.deckstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DeckStudio",
        "width": 1440,
        "height": 880,
        "minWidth": 1180,
        "minHeight": 740,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http://127.0.0.1:19876; object-src 'none'; form-action 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../../../target/release/deck-engine.exe": "deck-engine.exe",
      "../../../../scripts/sensor-doctor.ps1": "scripts/sensor-doctor.ps1"
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  }
}
